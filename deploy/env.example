# Copy to /etc/kagami/env, mode 600, owned by root. Never commit the real one.
KAGAMI_BASE_URL=https://example.org
KAGAMI_PAGES_SINCE=14

# Cloudflare API token scoped to Workers and R2 only (used by wrangler).
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=

# R2's S3 interface, for the archive (rclone) and the backup (litestream).
R2_ENDPOINT=https://<account id>.r2.cloudflarestorage.com
LITESTREAM_ACCESS_KEY_ID=
LITESTREAM_SECRET_ACCESS_KEY=
RCLONE_CONFIG_R2_TYPE=s3
RCLONE_CONFIG_R2_PROVIDER=Cloudflare
RCLONE_CONFIG_R2_ENDPOINT=https://<account id>.r2.cloudflarestorage.com
RCLONE_CONFIG_R2_ACCESS_KEY_ID=
RCLONE_CONFIG_R2_SECRET_ACCESS_KEY=

# healthchecks.io ping URLs; leave empty to skip.
HC_SITE_URL=
HC_DAILY_URL=
