// The public site: static files from `firstreport site`, plus a small Worker
// that answers only when a file is missing, by looking in the archive
// bucket. See docs/deploy.md.
{
  "name": "firstreport-site",
  "main": "worker.js",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "../site",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  },
  // The deploy token needs Workers Routes, Zone Read and DNS Edit on this
  // zone for wrangler to keep the custom domain attached.
  "routes": [
    { "pattern": "firstreport.cc", "custom_domain": true }
  ],
  "r2_buckets": [
    { "binding": "ARCHIVE", "bucket_name": "firstreport-archive" }
  ]
}
