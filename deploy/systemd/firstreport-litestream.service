[Unit]
Description=Litestream: replicate feed.db to R2
After=network-online.target
Wants=network-online.target

[Service]
User=firstreport
EnvironmentFile=/etc/firstreport/env
ExecStart=/usr/bin/litestream replicate -config /home/firstreport/firstreport/deploy/litestream.yml
Restart=on-failure
RestartSec=10

[Install]
WantedBy=multi-user.target
